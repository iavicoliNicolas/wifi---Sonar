# Copiá este archivo a .env si querés sobreescribir los defaults.
# El servidor solo escucha en la máquina local.

WIFI_SONAR_HOST=127.0.0.1
WIFI_SONAR_PORT=8000
WIFI_SONAR_DB=data/wifi_sonar.sqlite
WIFI_SONAR_SOURCE=sim
WIFI_SONAR_SEED=0
# Lista blanca para el modo degradado. No se descubren vecinos.
WIFI_SONAR_RSSI_DEVICES=telefono
WIFI_SONAR_WEBHOOK_URL=
